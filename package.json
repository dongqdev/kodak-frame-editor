{
  "name": "kodak-frame-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "디지털액자(mx1.kodakframes.com) 이메일 업로드 전, 사진을 1000x1600 비율로 미리 크롭해서 보내는 웹 도구",
  "scripts": {
    "start": "node src/server.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "cropperjs": "^1.6.2",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "heic2any": "^0.0.4",
    "multer": "^2.0.0",
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6"
  },
  "lint-staged": {
    "*": [
      "prettier --write --ignore-unknown"
    ]
  }
}
